# --------------------------------------------------
# API & App Configuration
# --------------------------------------------------

# The URL where your Laravel API is running (Sanctum/Stateful cookies)
VITE_API_URL=http://localhost:8000/api

# Base URL of your app (frontend) - used for CSRF requests or redirects
VITE_APP_URL=http://localhost:5173

# App Name (can be used in UI)
VITE_APP_NAME="Ecommerce STORE"

# Optional: API timeout (in ms)
VITE_API_TIMEOUT=10000